# ==========================================
# ATWAIS Weather Monitoring System Configuration
# Copy this file to .env and insert your API keys
# ==========================================

# Server Configuration
PORT=5000
DEBUG=True

# Weather Data Provider: 'openmeteo', 'openweathermap', or 'weatherapi'
WEATHER_PROVIDER=openmeteo

# OpenWeatherMap API Credentials
# Sign up and generate a free API key at: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# WeatherAPI.com Credentials (Alternative Provider)
# Sign up and generate a free API key at: https://www.weatherapi.com/signup.aspx
WEATHERAPI_KEY=your_weatherapi_key_here

# Default Target Surveillance Location
DEFAULT_CITY=Chennai
DEFAULT_LAT=13.0827
DEFAULT_LON=80.2707
