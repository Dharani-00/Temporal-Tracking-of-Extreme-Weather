# ==========================================
# ATWAIS Weather Monitoring System Configuration
# ==========================================

# Server Configuration
PORT=5000
DEBUG=True

# Weather Data Provider
# Options:
#   - openmeteo     : Free, high-accuracy global weather data, NO API KEY REQUIRED (Default)
#   - openweathermap: Uses OpenWeatherMap API (Requires OPENWEATHER_API_KEY below)
#   - weatherapi    : Uses WeatherAPI.com (Requires WEATHERAPI_KEY below)
WEATHER_PROVIDER=openmeteo

# OpenWeatherMap API Credentials
# Get your free key at: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# WeatherAPI.com Credentials (Alternative Provider)
# Get your free key at: https://www.weatherapi.com/signup.aspx
WEATHERAPI_KEY=your_weatherapi_key_here

# Default Location Settings (Initialized on page load)
DEFAULT_CITY=Chennai
DEFAULT_LAT=13.0827
DEFAULT_LON=80.2707
